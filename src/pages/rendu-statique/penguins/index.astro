---
import TP4Layout from "../../../layouts/TP4Layout.astro";
import penguins from "../../../assets/penguins.json";

const species = [
  ...new Set(
    penguins.map((penguin) => penguin.species)
  ),
];
---

<TP4Layout title="Penguins — Rendu statique">

  <section class="hero">

    <a href="/rendu-statique" class="back">
      <span>←</span>
      Statique
    </a>

    <div class="tag">
      <span class="pulse"></span>
      PENGUINS · STATIC
    </div>

    <h1>
      Choisis une
      <span>espèce.</span>
    </h1>

    <p>
      Chaque visualisation est générée statiquement
      avec <code>getStaticPaths()</code>.
    </p>

  </section>


  <section class="species-grid">

    {
      species.map((nomSpecies, index) => (

        <a
          href={`/rendu-statique/${nomSpecies}`}
          class="species-card"
          style={`--delay: ${index * 0.08}s`}
        >

          <div class="card-header">

            <span class="number">
              0{index + 1}
            </span>

            <span class="badge">
              SPECIES
            </span>

          </div>


          <div class="mini-plot">

            <div class="axis axis-x"></div>
            <div class="axis axis-y"></div>

            <span class="dot dot-1"></span>
            <span class="dot dot-2"></span>
            <span class="dot dot-3"></span>
            <span class="dot dot-4"></span>
            <span class="dot dot-5"></span>

          </div>


          <div class="card-bottom">

            <div>

              <p>
                PENGUINS
              </p>

              <h2>
                {nomSpecies}
              </h2>

            </div>

            <span class="arrow">
              ↗
            </span>

          </div>

        </a>

      ))
    }

  </section>

</TP4Layout>


<style>

  .hero {
    max-width: 760px;

    margin-bottom: 60px;

    animation: reveal 0.6s ease both;
  }


  .back {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    margin-bottom: 45px;

    color: #777c8c;

    font-size: 13px;
    font-weight: 700;

    text-decoration: none;

    transition: 0.2s;
  }


  .back:hover {
    color: white;
  }


  .tag {
    display: flex;

    align-items: center;

    gap: 9px;

    margin-bottom: 18px;

    color: #8b7cff;

    font-size: 11px;
    font-weight: 800;

    letter-spacing: 2px;
  }


  .pulse {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #8b7cff;

    animation: pulse 2s infinite;
  }


  h1 {
    margin-bottom: 20px;

    font-size: clamp(48px, 7vw, 78px);

    line-height: 0.95;

    letter-spacing: -4px;
  }


  h1 span {
    color: #8b7cff;
  }


  .hero > p {
    margin: 0;

    color: #8d92a2;

    font-size: 17px;

    line-height: 1.7;
  }


  code {
    padding: 4px 7px;

    border-radius: 6px;

    color: #b1a7ff;

    background:
      rgba(139, 124, 255, 0.08);
  }


  /* GRID */

  .species-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 18px;
  }


  .species-card {
    min-height: 390px;

    padding: 24px;

    display: flex;

    flex-direction: column;

    overflow: hidden;

    border:
      1px solid
      rgba(255, 255, 255, 0.08);

    border-radius: 20px;

    color: white;

    background:
      linear-gradient(
        145deg,
        rgba(22, 24, 35, 0.95),
        rgba(12, 14, 22, 0.95)
      );

    text-decoration: none;

    opacity: 0;

    animation:
      cardReveal
      0.6s
      ease
      forwards;

    animation-delay:
      var(--delay);

    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }


  .species-card:hover {
    transform: translateY(-7px);

    border-color:
      rgba(139, 124, 255, 0.55);

    box-shadow:
      0 25px 60px
      rgba(0, 0, 0, 0.25);
  }


  .card-header {
    display: flex;

    justify-content: space-between;

    align-items: center;
  }


  .number {
    color: #656a79;

    font-size: 11px;

    font-weight: 800;
  }


  .badge {
    padding: 6px 9px;

    border:
      1px solid
      rgba(139, 124, 255, 0.22);

    border-radius: 999px;

    color: #a99fff;

    font-size: 9px;
    font-weight: 800;

    letter-spacing: 1px;
  }


  /* MINI GRAPH */

  .mini-plot {
    position: relative;

    height: 200px;

    margin: 20px 0;

    background:
      linear-gradient(
        rgba(139, 124, 255, 0.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(139, 124, 255, 0.025) 1px,
        transparent 1px
      );

    background-size: 28px 28px;
  }


  .axis {
    position: absolute;

    background:
      rgba(255, 255, 255, 0.08);
  }


  .axis-x {
    left: 20px;
    right: 10px;

    bottom: 20px;

    height: 1px;
  }


  .axis-y {
    left: 20px;

    top: 10px;
    bottom: 20px;

    width: 1px;
  }


  .dot {
    position: absolute;

    width: 7px;
    height: 7px;

    border:
      2px solid #8b7cff;

    border-radius: 50%;

    box-shadow:
      0 0 10px
      rgba(139, 124, 255, 0.4);

    transition:
      transform 0.35s ease;
  }


  .dot-1 {
    left: 22%;
    bottom: 29%;
  }


  .dot-2 {
    left: 38%;
    bottom: 40%;
  }


  .dot-3 {
    left: 51%;
    bottom: 47%;
  }


  .dot-4 {
    left: 66%;
    bottom: 61%;
  }


  .dot-5 {
    left: 81%;
    bottom: 73%;
  }


  .species-card:hover .dot {
    transform:
      translateY(-6px)
      scale(1.2);
  }


  /* BOTTOM */

  .card-bottom {
    margin-top: auto;

    display: flex;

    align-items: flex-end;

    justify-content: space-between;
  }


  .card-bottom p {
    margin: 0 0 5px;

    color: #656a79;

    font-size: 9px;
    font-weight: 800;

    letter-spacing: 1.5px;
  }


  h2 {
    margin: 0;

    font-size: 26px;
  }


  .arrow {
    width: 43px;
    height: 43px;

    display: grid;

    place-items: center;

    border:
      1px solid
      rgba(139, 124, 255, 0.3);

    border-radius: 50%;

    color: #8b7cff;

    font-size: 18px;

    transition: 0.3s;
  }


  .species-card:hover .arrow {
    color: #0b0d14;

    background: #8b7cff;

    transform: rotate(45deg);
  }


  /* ANIMATIONS */

  @keyframes reveal {

    from {
      opacity: 0;

      transform: translateY(15px);
    }

    to {
      opacity: 1;

      transform: translateY(0);
    }

  }


  @keyframes cardReveal {

    from {
      opacity: 0;

      transform: translateY(20px);
    }

    to {
      opacity: 1;

      transform: translateY(0);
    }

  }


  @keyframes pulse {

    0% {
      box-shadow:
        0 0 0 0
        rgba(139, 124, 255, 0.5);
    }

    70% {
      box-shadow:
        0 0 0 8px
        rgba(139, 124, 255, 0);
    }

    100% {
      box-shadow:
        0 0 0 0
        rgba(139, 124, 255, 0);
    }

  }


  @media (max-width: 900px) {

    .species-grid {
      grid-template-columns: 1fr;
    }


    .species-card {
      min-height: 350px;
    }

  }

</style>