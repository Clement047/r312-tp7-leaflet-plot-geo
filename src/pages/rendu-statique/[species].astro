---
import TP4Layout from "../../layouts/TP4Layout.astro";
import GraphicSpecies from "../../components/GraphicSpecies.astro";
import penguins from "../../assets/penguins.json";

export function getStaticPaths() {
  const species = [
    ...new Set(
      penguins.map((penguin) => penguin.species)
    ),
  ];

  return species.map((nomSpecies) => ({
    params: {
      species: nomSpecies,
    },
  }));
}

const { species } = Astro.params;

const filteredPenguins = penguins.filter(
  (penguin) => penguin.species === species
);

const nombre = filteredPenguins.length;
---

<TP4Layout title={`${species} — Penguin statique`}>

  <section class="page-header">

    <a href="/rendu-statique/penguins" class="back">
      ← Penguins
    </a>

    <div class="header-layout">

      <div class="heading">

        <div class="tag">
          <span class="static-icon"></span>
          PENGUINS · STATIC
        </div>

        <h1>
          {species}<span>.</span>
        </h1>

        <p>
          Relation entre la longueur du bec et la masse corporelle
          des manchots de l'espèce {species}.
        </p>

      </div>


      <div class="route-card">

        <div class="route-top">

          <span class="route-status"></span>

          STATIC ROUTE

        </div>

        <code>
          /rendu-statique/{species}
        </code>

        <div class="route-bottom">

          <span>
            BUILD
          </span>

          <strong>
            getStaticPaths()
          </strong>

        </div>

      </div>

    </div>

  </section>


  <!-- STATS -->

  <section class="stats">

    <div class="stat">

      <span class="stat-label">
        OBSERVATIONS
      </span>

      <strong>
        {nombre}
      </strong>

      <span class="stat-description">
        individus
      </span>

    </div>


    <div class="stat">

      <span class="stat-label">
        DATASET
      </span>

      <strong>
        Penguins
      </strong>

      <span class="stat-description">
        {species}
      </span>

    </div>


    <div class="stat">

      <span class="stat-label">
        RENDER
      </span>

      <strong>
        STATIC
      </strong>

      <span class="stat-description">
        getStaticPaths()
      </span>

    </div>

  </section>


  <!-- GRAPH -->

  <section class="chart-section">

    <div class="chart-heading">

      <div>

        <span class="chart-label">
          01 / SCATTER PLOT
        </span>

        <h2>
          Bec × masse corporelle
        </h2>

      </div>


      <div class="status">

        <span></span>

        PRE-GENERATED

      </div>

    </div>


    <div class="chart-card">

      <div class="chart-background"></div>

      <span class="corner top-left"></span>
      <span class="corner bottom-right"></span>

      <div class="chart">
        <GraphicSpecies species={species} />
      </div>

    </div>


    <div class="legend">

      <div>

        <span>
          X
        </span>

        <strong>
          Longueur du bec (mm)
        </strong>

      </div>


      <div>

        <span>
          Y
        </span>

        <strong>
          Masse corporelle (g)
        </strong>

      </div>


      <div>

        <span>
          COLOR
        </span>

        <strong>
          Sexe
        </strong>

      </div>

    </div>

  </section>

</TP4Layout>


<style>

  /* ============================== */
  /* HEADER                         */
  /* ============================== */

  .page-header {
    padding:
      20px
      0
      55px;

    animation:
      reveal
      0.65s
      ease
      both;
  }


  .back {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    margin-bottom: 45px;

    color: #74798a;

    font-size: 13px;
    font-weight: 700;

    text-decoration: none;

    transition:
      color
      0.2s,
      transform
      0.2s;
  }


  .back:hover {
    color: white;

    transform:
      translateX(-3px);
  }


  .header-layout {
    display: grid;

    grid-template-columns:
      1fr
      330px;

    align-items: end;

    gap: 70px;
  }


  .tag {
    display: flex;

    align-items: center;

    gap: 9px;

    margin-bottom: 15px;

    color: #8b7cff;

    font-size: 10px;
    font-weight: 800;

    letter-spacing: 2px;
  }


  .static-icon {
    width: 7px;
    height: 7px;

    border:
      1px solid
      #8b7cff;

    transform:
      rotate(45deg);

    box-shadow:
      0 0 10px
      rgba(139,124,255,0.6);
  }


  h1 {
    margin:
      0
      0
      20px;

    color: white;

    font-size:
      clamp(
        65px,
        9vw,
        110px
      );

    line-height: 0.85;

    letter-spacing: -7px;
  }


  h1 span {
    color: #8b7cff;
  }


  .heading p {
    max-width: 620px;

    margin: 0;

    color: #818696;

    font-size: 16px;

    line-height: 1.65;
  }


  /* ============================== */
  /* ROUTE CARD                     */
  /* ============================== */

  .route-card {
    position: relative;

    padding: 22px;

    overflow: hidden;

    border:
      1px solid
      rgba(139,124,255,0.15);

    border-radius: 16px;

    background:
      linear-gradient(
        145deg,
        rgba(139,124,255,0.05),
        rgba(255,255,255,0.015)
      );
  }


  .route-card::before {
    content: "";

    position: absolute;

    width: 120px;
    height: 120px;

    top: -70px;
    right: -50px;

    border-radius: 50%;

    background:
      rgba(139,124,255,0.12);

    filter:
      blur(35px);
  }


  .route-top {
    position: relative;

    display: flex;

    align-items: center;

    gap: 8px;

    margin-bottom: 18px;

    color: #777c8c;

    font-size: 8px;
    font-weight: 800;

    letter-spacing: 1.5px;
  }


  .route-status {
    width: 7px;
    height: 7px;

    border:
      1px solid
      #8b7cff;

    transform:
      rotate(45deg);
  }


  .route-card code {
    position: relative;

    display: block;

    padding-bottom: 20px;

    color: #aaa1ff;

    font-size: 11px;

    overflow-wrap: anywhere;
  }


  .route-bottom {
    position: relative;

    padding-top: 15px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    border-top:
      1px solid
      rgba(255,255,255,0.06);
  }


  .route-bottom span {
    color: #555a69;

    font-size: 8px;
    font-weight: 800;

    letter-spacing: 1px;
  }


  .route-bottom strong {
    color: #8d92a0;

    font-family: monospace;

    font-size: 10px;
  }


  /* ============================== */
  /* STATS                          */
  /* ============================== */

  .stats {
    display: grid;

    grid-template-columns:
      repeat(3,1fr);

    margin-bottom: 75px;

    border-top:
      1px solid
      rgba(255,255,255,0.07);

    border-bottom:
      1px solid
      rgba(255,255,255,0.07);
  }


  .stat {
    min-height: 125px;

    padding: 25px;

    display: flex;

    flex-direction: column;

    justify-content: center;

    border-right:
      1px solid
      rgba(255,255,255,0.07);

    transition:
      background
      0.3s;
  }


  .stat:last-child {
    border-right: 0;
  }


  .stat:hover {
    background:
      rgba(139,124,255,0.025);
  }


  .stat-label {
    margin-bottom: 9px;

    color: #585d6c;

    font-size: 8px;
    font-weight: 800;

    letter-spacing: 1.5px;
  }


  .stat strong {
    color: #f1f1f4;

    font-size: 23px;
  }


  .stat-description {
    margin-top: 4px;

    color: #656a79;

    font-size: 11px;
  }


  /* ============================== */
  /* GRAPH                          */
  /* ============================== */

  .chart-section {
    padding-bottom: 100px;

    animation:
      reveal
      0.7s
      0.1s
      ease
      both;
  }


  .chart-heading {
    margin-bottom: 24px;

    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 30px;
  }


  .chart-label {
    display: block;

    margin-bottom: 9px;

    color: #8b7cff;

    font-size: 9px;
    font-weight: 800;

    letter-spacing: 1.8px;
  }


  .chart-heading h2 {
    margin: 0;

    font-size:
      clamp(
        30px,
        4vw,
        44px
      );

    letter-spacing: -2px;
  }


  .status {
    display: flex;

    align-items: center;

    gap: 8px;

    color: #747988;

    font-size: 9px;
    font-weight: 800;

    letter-spacing: 1px;
  }


  .status span {
    width: 7px;
    height: 7px;

    border:
      1px solid
      #8b7cff;

    transform:
      rotate(45deg);
  }


  /* ============================== */
  /* GRAPH CARD                     */
  /* ============================== */

  .chart-card {
    position: relative;

    min-height: 530px;

    padding: 40px;

    display: grid;

    place-items: center;

    overflow: hidden;

    border-radius: 22px;

    background:
      linear-gradient(
        145deg,
        #fafafd,
        #eeeef3
      );

    box-shadow:
      0 30px 80px
      rgba(0,0,0,0.22);

    transition:
      transform
      0.35s,
      box-shadow
      0.35s;
  }


  .chart-card:hover {
    transform:
      translateY(-4px);

    box-shadow:
      0 40px 90px
      rgba(0,0,0,0.28);
  }


  .chart-background {
    position: absolute;

    inset: 0;

    opacity: 0.35;

    background:
      linear-gradient(
        rgba(20,20,30,0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(20,20,30,0.035) 1px,
        transparent 1px
      );

    background-size:
      45px
      45px;
  }


  .chart {
    position: relative;

    z-index: 2;

    width: 100%;

    display: flex;

    justify-content: center;

    color: #171923;
  }


  /* ============================== */
  /* CORNERS                        */
  /* ============================== */

  .corner {
    position: absolute;

    z-index: 3;

    width: 25px;
    height: 25px;
  }


  .top-left {
    top: 18px;
    left: 18px;

    border-top:
      2px solid
      rgba(139,124,255,0.55);

    border-left:
      2px solid
      rgba(139,124,255,0.55);
  }


  .bottom-right {
    right: 18px;
    bottom: 18px;

    border-right:
      2px solid
      rgba(139,124,255,0.55);

    border-bottom:
      2px solid
      rgba(139,124,255,0.55);
  }


  /* ============================== */
  /* LEGEND                         */
  /* ============================== */

  .legend {
    display: grid;

    grid-template-columns:
      repeat(3,1fr);

    gap: 1px;

    margin-top: 12px;

    overflow: hidden;

    border-radius: 10px;

    background:
      rgba(255,255,255,0.06);
  }


  .legend div {
    padding:
      14px
      17px;

    display: flex;

    align-items: center;

    gap: 10px;

    background: #10121a;
  }


  .legend span {
    color: #5e6372;

    font-size: 8px;
    font-weight: 800;

    letter-spacing: 1px;
  }


  .legend strong {
    color: #969aa7;

    font-size: 10px;
  }


  /* ============================== */
  /* ANIMATIONS                     */
  /* ============================== */

  @keyframes reveal {

    from {
      opacity: 0;

      transform:
        translateY(20px);
    }

    to {
      opacity: 1;

      transform:
        translateY(0);
    }

  }


  /* ============================== */
  /* RESPONSIVE                     */
  /* ============================== */

  @media (max-width: 850px) {

    .header-layout {
      grid-template-columns: 1fr;
    }


    h1 {
      letter-spacing: -4px;
    }


    .route-card {
      width: 100%;
    }


    .stats {
      grid-template-columns: 1fr;
    }


    .stat {
      border-right: 0;

      border-bottom:
        1px solid
        rgba(255,255,255,0.07);
    }


    .stat:last-child {
      border-bottom: 0;
    }


    .chart-card {
      min-height: 440px;

      padding:
        25px
        10px;
    }


    .legend {
      grid-template-columns: 1fr;
    }

  }

</style>