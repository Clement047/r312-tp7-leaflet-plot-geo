
---
import TP4Layout from "../layouts/TP4Layout.astro";
import populationMain from "../assets/populationMain.json";

// Comme dans les consignes : récupérer les valeurs des données.
const listePeriode = [...new Set(populationMain.map((d) => d.Période))].sort(
  (a, b) => a - b
);
---

<TP4Layout title="GeoJSON — Carte interactive">
  <main class="page">
    <a href="/" class="retour">← Retour à l'accueil</a>

    <section class="hero">
      <span class="eyebrow">TP7 / OBSERVABLE PLOT</span>
      <h1>La France <span>en données.</span></h1>
      <p>
        Explore la population des départements français selon l'année,
        le sexe et la tranche d'âge.
      </p>
    </section>

    <section class="map-card">
      <div class="card-top">
        <span>04 / CARTE INTERACTIVE</span>
        <span>RENDU CÔTÉ CLIENT</span>
      </div>

      <div class="filters">
        <div class="filter">
          <label for="periode">Année</label>
          <select id="periode">
            {listePeriode.map((annee) => (
              <option value={annee} selected={annee === 2015}>
                {annee}
              </option>
            ))}
          </select>
        </div>

        <div class="filter">
          <label for="sexe">Sexe</label>
          <select id="sexe">
            <option value="Total">Total</option>
            <option value="Femme">Femme</option>
            <option value="Homme">Homme</option>
          </select>
        </div>

        <div class="filter">
          <label for="age">Tranche d'âge</label>
          <select id="age"></select>
        </div>
      </div>

      <p id="filter-info" class="filter-info"></p>

      <div class="stats" aria-live="polite">
        <div>
          <span class="stat-label">POPULATION CORRESPONDANTE</span>
          <strong id="total-population">—</strong>
        </div>
        <div>
          <span class="stat-label">DÉPARTEMENTS AVEC DONNÉES</span>
          <strong id="departement-count">—</strong>
        </div>
        <div>
          <span class="stat-label">SÉLECTION ACTIVE</span>
          <strong id="selection-active">—</strong>
        </div>
      </div>

      <div id="carte" class="map-content"></div>

      <div class="card-footer">
        <span>POPULATION PAR DÉPARTEMENT</span>
        <span>2010 — 2021</span>
      </div>
    </section>
  </main>
</TP4Layout>

<script>
  import * as Plot from "@observablehq/plot";
  import departements from "../assets/departements.geojson.json";
  import population from "../assets/populationMain.json";

  const periode = document.getElementById("periode");
  const sexe = document.getElementById("sexe");
  const age = document.getElementById("age");
  const carte = document.getElementById("carte");

  const filterInfo = document.getElementById("filter-info");
  const totalPopulation = document.getElementById("total-population");
  const departementCount = document.getElementById("departement-count");
  const selectionActive = document.getElementById("selection-active");

  // Récupération des catégories présentes pour une sélection.
  function lignesDisponibles() {
    const annee = Number(periode.value);

    return population.filter((d) => d["Période"] === annee);
  }

  function actualiserSexes() {
    const lignes = lignesDisponibles();
    const ancienSexe = sexe.value;

    const sexesDisponibles = new Set(lignes.map((d) => d["Sexe"]));

    for (const option of sexe.options) {
      const disponible = sexesDisponibles.has(option.value);
      option.disabled = !disponible;
      option.textContent = disponible
        ? option.value
        : `${option.value} (indisponible)`;
    }

    sexe.value = sexesDisponibles.has(ancienSexe)
      ? ancienSexe
      : "Total";
  }

  function actualiserAges() {
    const annee = Number(periode.value);
    const sexeChoisi = sexe.value;
    const ancienAge = age.value;

    const agesDisponibles = [
      ...new Set(
        population
          .filter(
            (d) =>
              d["Période"] === annee &&
              d["Sexe"] === sexeChoisi
          )
          .map((d) => d["Âge"])
      ),
    ];

    agesDisponibles.sort((a, b) => {
      if (a === "Total") return -1;
      if (b === "Total") return 1;
      return a.localeCompare(b, "fr");
    });

    age.replaceChildren();

    for (const valeur of agesDisponibles) {
      const option = document.createElement("option");
      option.value = valeur;
      option.textContent = valeur.trim();
      age.appendChild(option);
    }

    age.value = agesDisponibles.includes(ancienAge)
      ? ancienAge
      : agesDisponibles.includes("Total")
        ? "Total"
        : agesDisponibles[0] ?? "";
  }

  function actualiserCarte() {
    const annee = Number(periode.value);
    const sexeChoisi = sexe.value;
    const ageChoisi = age.value;

    // Même principe que l'exemple du professeur :
    // rechercher les lignes correspondant aux trois paramètres.
    const lignes = population.filter(
      (d) =>
        d["Période"] === annee &&
        d["Sexe"] === sexeChoisi &&
        d["Âge"] === ageChoisi &&
        d["Niveau Géo"] === "Département"
    );

    const populations = new Map();

    for (const ligne of lignes) {
      const nom = ligne["Géographie"];
      const valeur = Number(ligne["Valeur"]);

      if (Number.isFinite(valeur)) {
        populations.set(nom, valeur);
      }
    }

    // Statistiques visibles : elles changent avec les filtres.
    const total = [...populations.values()].reduce(
      (somme, valeur) => somme + valeur,
      0
    );

    totalPopulation.textContent = total.toLocaleString("fr-FR");
    departementCount.textContent = `${populations.size} / 96`;
    selectionActive.textContent =
      `${annee} · ${sexeChoisi} · ${ageChoisi.trim()}`;

    filterInfo.textContent =
      annee === 2021
        ? "En 2021, les données sont disponibles par sexe."
        : `En ${annee}, seules les données « Total » sont disponibles pour le sexe.`;

    const options = {
      width: 1050,
      height: 850,

      title: "Population des départements français",
      subtitle: `${annee} · ${sexeChoisi} · ${ageChoisi.trim()}`,
      caption: "Source : données du TP7.",

      ariaLabel:
        `Carte de la population des départements français en ${annee}, ` +
        `pour ${sexeChoisi}, tranche d'âge ${ageChoisi.trim()}.`,

      style: {
        background: "transparent",
        color: "#e5e7f0",
        fontFamily: "Arial, sans-serif",
        fontSize: "13px",
      },

      projection: {
        type: "mercator",
        domain: departements,
      },

      color: {
        type: "quantile",
        n: 8,
        scheme: "Purples",
        label: "Population (habitants)",
        legend: true,
        unknown: "#343746",
      },

      marks: [
        Plot.geo(departements, {
          fill: (d) =>
            populations.get(d.properties.nom) ?? null,

          stroke: "#777b92",
          strokeWidth: 0.5,

          title: (d) => {
            const nom = d.properties.nom;
            const valeur = populations.get(nom);

            return valeur === undefined
              ? `${nom} : donnée indisponible`
              : `${nom} : ${valeur.toLocaleString("fr-FR")} habitants`;
          },

          tip: true,
        }),
      ],
    };

    const nouveauPlot = Plot.plot(options);

    // Remplace l'ancien graphique, pas la page entière.
    carte.replaceChildren(nouveauPlot);
  }

  // Les événements sont attachés une seule fois.
  periode.addEventListener("change", () => {
    actualiserSexes();
    actualiserAges();
    actualiserCarte();
  });

  sexe.addEventListener("change", () => {
    actualiserAges();
    actualiserCarte();
  });

  age.addEventListener("change", actualiserCarte);

  // Premier affichage.
  actualiserSexes();
  actualiserAges();
  actualiserCarte();
</script>

<style>
  .page {
    width: min(100% - 48px, 1500px);
    margin: 0 auto;
  }

  .retour {
    display: inline-block;
    margin: 28px 0;
    color: #a99eff;
    text-decoration: none;
  }

  .hero {
    margin: 25px 0 45px;
  }

  .eyebrow {
    color: #8b7cff;
    font-size: 12px;
    letter-spacing: 3px;
  }

  h1 {
    font-size: clamp(36px, 6vw, 72px);
    font-weight: 800;
    letter-spacing: -3px;
    margin: 16px 0;
  }

  h1 span {
    color: #8b7cff;
  }

  .hero p {
    color: #a8acc2;
    max-width: 650px;
    line-height: 1.7;
  }

  .map-card {
    background: #10121b;
    border: 1px solid #292b40;
    border-radius: 18px;
    overflow: hidden;
    margin-bottom: 60px;
  }

  .card-top,
  .card-footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 24px;
    font-size: 11px;
    letter-spacing: 1.5px;
    color: #989bb3;
  }

  .card-top {
    border-bottom: 1px solid #292b40;
  }

  .card-footer {
    border-top: 1px solid #292b40;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    padding: 25px;
  }

  .filter {
    display: flex;
    flex: 1;
    min-width: 180px;
    flex-direction: column;
    gap: 10px;
  }

  .filter label {
    font-size: 12px;
    color: #b9bad0;
  }

  .filter select {
    width: 100%;
    background: #191b2a;
    color: #fff;
    border: 1px solid #41435b;
    border-radius: 8px;
    padding: 12px;
    cursor: pointer;
    font-size: 14px;
  }

  .filter select:focus {
    outline: 2px solid #8b7cff;
    outline-offset: 2px;
  }

  .filter-info {
    margin: 0;
    padding: 0 25px 20px;
    color: #a8acc2;
    font-size: 12px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    padding: 22px 25px;
    border-top: 1px solid #292b40;
    border-bottom: 1px solid #292b40;
  }

  .stats > div {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .stat-label {
    font-size: 10px;
    letter-spacing: 1.4px;
    color: #989bb3;
  }

  .stats strong {
    color: #c4b5fd;
    font-size: clamp(15px, 2vw, 25px);
    overflow-wrap: anywhere;
  }

  .map-content {
    padding: 25px;
    overflow-x: auto;
    display: flex;
    justify-content: center;
  }

  .map-content :global(figure) {
    margin: 0;
    max-width: 100%;
  }

  .map-content :global(svg) {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 600px) {
    .page {
      width: min(100% - 24px, 1500px);
    }

    .card-top,
    .card-footer {
      flex-direction: column;
      gap: 8px;
    }

    .stats {
      grid-template-columns: 1fr;
    }

    .map-content {
      padding: 12px;
    }
  }
</style>
