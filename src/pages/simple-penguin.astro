
---
import TP4Layout from "../layouts/TP4Layout.astro";
---

<TP4Layout title="Simple Penguin — TP7">

  <a href="/" class="retour">← Retour à l'accueil</a>

  <section class="hero">
    <div class="hero-tag">
      <span class="pulse"></span>
      DATA VISUALISATION / ACCESSIBILITÉ
    </div>

    <h1>
      Explore les<br />
      <span>pingouins.</span>
    </h1>

    <p>
      Une visualisation interactive des caractéristiques du bec
      des pingouins, différenciées selon leur espèce.
      Un graphique conçu pour être plus accessible.
    </p>
  </section>

  <section class="plot-card" aria-label="Visualisation des pingouins">
    <div class="card-top">
      <span class="number">01 / OBSERVABLE PLOT</span>
      <span class="status">ACCESSIBILITÉ A11Y</span>
    </div>

    <div id="plot"></div>

    <div class="card-footer">
      <span>DATASET / PENGUINS</span>
      <span>LONGUEUR × PROFONDEUR DU BEC</span>
    </div>
  </section>

</TP4Layout>

<script>
  import * as Plot from "@observablehq/plot";
  import penguins from "../assets/penguins.json";

  const container = document.getElementById("plot");

  function renderPlot() {
    if (!container) return;

    const graphique = Plot.plot({
      width: 1000,
      height: 590,

      // Direction artistique PLOT / LAB
      style: {
        background: "#10121b",
        color: "#e5e7f0",
        fontFamily: "Arial, sans-serif",
        fontSize: "13px",
      },

      // Accessibilité du graphique
      title: "Morphologie du bec des pingouins",

      subtitle:
        "Comparaison de la longueur et de la profondeur du bec selon l'espèce.",

      caption:
        "Source : dataset Penguins. Chaque point représente un pingouin. Les couleurs distinguent les trois espèces.",

      ariaLabel:
        "Nuage de points représentant la longueur et la profondeur du bec des pingouins en millimètres, avec une couleur différente pour chaque espèce.",

      marginTop: 45,
      marginRight: 35,
      marginBottom: 65,
      marginLeft: 75,

      color: {
        domain: ["Adelie", "Chinstrap", "Gentoo"],
        range: ["#8b7cff", "#ffbf69", "#62d5e8"],
        legend: true,
      },

      x: {
        label: "Longueur du bec (mm)",
        grid: true,
        tickSize: 0,
      },

      y: {
        label: "Profondeur du bec (mm)",
        grid: true,
        tickSize: 0,
      },

      marks: [
        Plot.dot(penguins, {
          x: "culmen_length_mm",
          y: "culmen_depth_mm",
          stroke: "species",
          strokeWidth: 2,
          r: 4,
          tip: true,
        }),
      ],
    });

    // Correction ciblée de l'erreur Lighthouse :
    // retirer les aria-label des groupes SVG sans rôle explicite.
    // On conserve les informations d'accessibilité du graphique.
    graphique.querySelectorAll("svg g[aria-label]").forEach((element) => {
      if (!element.hasAttribute("role")) {
        element.removeAttribute("aria-label");
      }
    });

    container.replaceChildren(graphique);
  }

  renderPlot();
</script>

<style>
  .retour {
    display: inline-block;
    margin-bottom: 55px;
    color: #a9adbd;
    text-decoration: none;
    transition: color 0.2s;
  }

  .retour:hover {
    color: #b5aaff;
  }

  .hero {
    max-width: 850px;
    margin-bottom: 60px;
    animation: reveal 0.7s ease both;
  }

  .hero-tag {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 22px;
    color: #a99fff;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .pulse {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #8b7cff;
    animation: pulse 2s infinite;
  }

  h1 {
    max-width: 850px;
    margin: 0 0 25px;
    color: #f4f4fa;
    font-size: clamp(44px, 6.5vw, 82px);
    line-height: 1.08;
    letter-spacing: -2.5px;
  }

  h1 span {
    color: #8b7cff;
  }

  .hero > p {
    max-width: 650px;
    margin: 0;
    color: #a9adbd;
    font-size: 17px;
    line-height: 1.7;
  }

  .plot-card {
    position: relative;
    padding: 30px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 22px;
    background: linear-gradient(
      145deg,
      rgba(22, 24, 35, 0.98),
      rgba(12, 14, 22, 0.98)
    );
    animation: reveal 0.7s ease both;
  }

  .plot-card::before {
    content: "";
    position: absolute;
    top: -170px;
    right: -110px;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: rgba(139, 124, 255, 0.12);
    filter: blur(55px);
    pointer-events: none;
  }

  .card-top,
  .card-footer {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
  }

  .number,
  .card-footer {
    color: #a0a5b5;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
  }

  .status {
    padding: 8px 12px;
    border: 1px solid rgba(139, 124, 255, 0.35);
    border-radius: 999px;
    color: #b5aaff;
    background: rgba(139, 124, 255, 0.08);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  #plot {
    position: relative;
    z-index: 1;
    margin: 35px 0 25px;
    padding: 20px;
    overflow-x: auto;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 15px;
    background: #10121b;
  }

  #plot :global(figure) {
    margin: 0;
    max-width: 100%;
  }

  #plot :global(svg) {
    max-width: 100%;
    height: auto;
  }

  #plot :global(figcaption) {
    margin-top: 18px;
    color: #b9bdcc;
    line-height: 1.6;
  }

  #plot :global(.plot-grid line) {
    stroke: rgba(255, 255, 255, 0.12);
  }

  .card-footer {
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(139, 124, 255, 0.5);
    }

    70% {
      box-shadow: 0 0 0 8px rgba(139, 124, 255, 0);
    }

    100% {
      box-shadow: 0 0 0 0 rgba(139, 124, 255, 0);
    }
  }

  @media (max-width: 800px) {
    .plot-card {
      padding: 18px;
    }

    #plot {
      padding: 12px;
    }

    h1 {
      font-size: clamp(38px, 8vw, 64px);
      letter-spacing: -1.5px;
    }

    .card-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 480px) {
    h1 {
      font-size: 36px;
      letter-spacing: -1px;
    }

    .hero > p {
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero,
    .plot-card,
    .pulse {
      animation: none;
    }
  }
</style>
