---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Weather avec filtre</title>
  </head>

  <body>
    <main class="page">
      <a href="/" class="retour">← Retour à l'accueil</a>

      <div class="header">
        <p class="eyebrow">DATA VISUALISATION</p>

        <h1>Weather avec filtre</h1>

        <p class="description">
          Visualisation de l'évolution des températures avec un filtrage
          dynamique selon les conditions météorologiques.
        </p>
      </div>

      <div class="filtres">
        <label for="weather-select">
          Météo
        </label>

        <select id="weather-select">
          <option value="all">Toutes les météos</option>
          <option value="sun">Soleil</option>
          <option value="rain">Pluie</option>
          <option value="snow">Neige</option>
          <option value="drizzle">Bruine</option>
          <option value="fog">Brouillard</option>
        </select>
      </div>

      <section class="graph-card">
        <div id="plot"></div>
      </section>
    </main>

    <script>
      import * as Plot from "@observablehq/plot";
      import weather from "../assets/weather.json";

      const select =
        document.querySelector<HTMLSelectElement>("#weather-select");

      const container =
        document.querySelector<HTMLDivElement>("#plot");

      function renderPlot() {
        if (!select || !container) return;

        // Récupère la valeur du select
        const valeur = select.value;

        // Filtre les données
        const donnees =
          valeur === "all"
            ? weather
            : weather.filter((d) => d.weather === valeur);

        // Transforme les dates en objets Date
        const donneesPreparees = donnees.map((d) => ({
          ...d,
          dateObjet: new Date(d.date),
        }));

        // Création du graphique
        const graphique = Plot.plot({
          width: 1100,
          height: 520,

          marginTop: 30,
          marginRight: 30,
          marginBottom: 55,
          marginLeft: 60,

          x: {
            label: "Date",
            grid: true,
          },

          y: {
            label: "Température (°C)",
            grid: true,
          },

          marks: [
            Plot.ruleY([0], {
              stroke: "#999",
            }),

            // Température maximale
            Plot.lineY(donneesPreparees, {
              x: "dateObjet",
              y: "temp_max",
              stroke: "#7c5cff",
              strokeWidth: 2,
            }),

            Plot.dot(donneesPreparees, {
              x: "dateObjet",
              y: "temp_max",
              fill: "#7c5cff",
              r: 2.5,
              tip: true,
            }),

            // Température minimale
            Plot.lineY(donneesPreparees, {
              x: "dateObjet",
              y: "temp_min",
              stroke: "#19b5fe",
              strokeWidth: 2,
            }),

            Plot.dot(donneesPreparees, {
              x: "dateObjet",
              y: "temp_min",
              fill: "#19b5fe",
              r: 2.5,
              tip: true,
            }),
          ],
        });

        // Remplace l'ancien graphique
        container.replaceChildren(graphique);
      }

      // Actualise lors du changement du select
      select?.addEventListener("change", renderPlot);

      // Affiche le graphique au chargement
      renderPlot();
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #090b12;
    color: #f7f7fb;
    font-family:
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 60px 40px 80px;
  }

  .retour {
    display: inline-block;
    margin-bottom: 45px;
    color: #a9a9b8;
    text-decoration: none;
    transition: 0.2s;
  }

  .retour:hover {
    color: #8b6cff;
  }

  .header {
    max-width: 750px;
    margin-bottom: 45px;
  }

  .eyebrow {
    color: #8b6cff;
    font-weight: 700;
    letter-spacing: 0.15em;
    font-size: 0.8rem;
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1;
    margin: 0 0 22px;
  }

  .description {
    color: #a9a9b8;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .filtres {
    margin-bottom: 30px;
  }

  .filtres label {
    display: block;
    font-weight: 600;
    margin-bottom: 10px;
  }

  select {
    min-width: 220px;
    padding: 14px 16px;
    border-radius: 12px;
    border: 2px solid #7c5cff;
    background: #171923;
    color: white;
    font-size: 1rem;
    outline: none;
  }

  select:focus {
    border-color: #9b87ff;
  }

  .graph-card {
    background: white;
    border-radius: 24px;
    padding: 35px;
    overflow-x: auto;
  }

  #plot {
    min-width: 800px;
  }

  @media (max-width: 700px) {
    .page {
      padding: 35px 20px;
    }

    .graph-card {
      padding: 15px;
    }
  }
</style>