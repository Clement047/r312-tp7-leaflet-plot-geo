
---
import TP4Layout from "../layouts/TP4Layout.astro";
---

<TP4Layout title="Accueil — TP7">
  <section class="hero">
    <div class="hero-grid"></div>

    <div class="hero-content">
      <div class="eyebrow">
        <span class="pulse"></span>
        TP7 / VISUALISATION DE DONNÉES
      </div>

      <h1>
        Explorer les données.
        <span>Autrement.</span>
      </h1>

      <p class="hero-description">
        De l'accessibilité des graphiques à la cartographie interactive :
        quatre expérimentations réalisées avec Astro, Observable Plot
        et Leaflet.
      </p>

      <div class="hero-actions">
        <a href="#explorations" class="button primary">
          Découvrir le TP7 <span aria-hidden="true">↗</span>
        </a>
        <a href="/geojson-interactif" class="button secondary">
          Explorer la carte
        </a>
      </div>
    </div>

    <div class="data-visual" aria-hidden="true">
      <div class="visual-header">
        <span>DATA / EXPLORATION</span>
        <span class="live"><i></i> TP07</span>
      </div>

      <div class="visual-scene">
        <div class="scene-grid"></div>
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>
        <div class="orbit orbit-three"></div>
        <div class="scene-core">
          <span>DATA</span>
        </div>
        <span class="scene-node n1"></span>
        <span class="scene-node n2"></span>
        <span class="scene-node n3"></span>
        <span class="scene-node n4"></span>
      </div>

      <div class="visual-footer">
        <div><small>MODULES</small><strong>04</strong></div>
        <div><small>CARTOGRAPHIE</small><strong>02</strong></div>
        <div><small>STACK</small><strong>ASTRO / PLOT</strong></div>
      </div>
    </div>
  </section>

  <section class="explore" id="explorations">
    <div class="section-heading">
      <div>
        <p class="section-index">01 / EXPLORATIONS</p>
        <h2>Quatre façons de <span>visualiser.</span></h2>
      </div>
      <p>
        Des graphiques accessibles aux données géographiques
        filtrables directement dans le navigateur.
      </p>
    </div>

    <div class="card-grid">
      <!-- ACCESSIBILITÉ -->
      <a href="/simple-penguin" class="project-card">
        <span class="card-number">01 / ACCESSIBILITÉ</span>
        <span class="card-arrow" aria-hidden="true">↗</span>

        <div class="card-visual a11y-visual" aria-hidden="true">
          <div class="chart-baseline"></div>
          <div class="bar-chart">
            <span style="--h:45%;--d:0s"></span>
            <span style="--h:70%;--d:.1s"></span>
            <span style="--h:55%;--d:.2s"></span>
            <span style="--h:90%;--d:.3s"></span>
            <span style="--h:65%;--d:.4s"></span>
            <span style="--h:80%;--d:.5s"></span>
          </div>
          <div class="a11y-label">
            <span class="a11y-check">✓</span>
            <span>ARIA / LABELS</span>
          </div>
        </div>

        <div class="card-content">
          <span class="card-category">OBSERVABLE PLOT</span>
          <h3>Accessibilité</h3>
          <p>
            Rendre les graphiques compréhensibles avec des titres,
            des descriptions et des attributs ARIA.
          </p>
          <span class="technology">Plot · ARIA · Lighthouse</span>
        </div>
      </a>

      <!-- LEAFLET -->
      <a href="/leaflet" class="project-card">
        <span class="card-number">02 / CARTOGRAPHIE</span>
        <span class="card-arrow" aria-hidden="true">↗</span>

        <div class="card-visual leaflet-visual" aria-hidden="true">
          <div class="map-grid"></div>
          <svg class="map-lines" viewBox="0 0 420 220" preserveAspectRatio="xMidYMid meet">
            <path d="M15 155 L95 125 L140 145 L200 75 L270 110 L345 35 L410 65" />
            <path d="M35 30 L100 90 L180 55 L250 155 L335 135 L405 195" />
            <path d="M75 205 L135 145 L230 175 L305 90 L380 110" />
          </svg>
          <span class="map-pin pin-one"><i></i></span>
          <span class="map-pin pin-two"><i></i></span>
          <span class="map-pin pin-three"><i></i></span>
          <span class="map-pin pin-four"><i></i></span>
          <span class="map-pin pin-five"><i></i></span>
        </div>

        <div class="card-content">
          <span class="card-category">LEAFLET.JS</span>
          <h3>Établissements</h3>
          <p>
            Explorer les établissements universitaires français
            sur une carte avec des marqueurs interactifs.
          </p>
          <span class="technology">Leaflet · OpenStreetMap</span>
        </div>
      </a>

      <!-- GEOJSON -->
      <a href="/geojson" class="project-card">
        <span class="card-number">03 / DONNÉES GÉOGRAPHIQUES</span>
        <span class="card-arrow" aria-hidden="true">↗</span>

        <div class="card-visual geo-visual" aria-hidden="true">
          <div class="geo-grid"></div>
          <div class="geo-shape">
            <svg viewBox="0 0 240 230" role="presentation">
              <path d="M57 15 L120 26 L176 10 L211 64 L197 120 L223 153 L178 211 L110 198 L60 219 L20 163 L38 107 L16 67 Z" />
              <path d="M120 26 L111 78 L38 107 M111 78 L197 120 M111 78 L110 198 M38 107 L110 198 M197 120 L178 211 M110 198 L178 211 M57 15 L111 78 M16 67 L111 78 M223 153 L110 198" />
            </svg>
          </div>
          <span class="geo-caption">96 DÉPARTEMENTS</span>
        </div>

        <div class="card-content">
          <span class="card-category">GEOJSON / PLOT</span>
          <h3>Population</h3>
          <p>
            Représenter les données démographiques françaises
            par département avec une carte choroplèthe.
          </p>
          <span class="technology">GeoJSON · Plot.geo</span>
        </div>
      </a>

      <!-- INTERACTIF -->
      <a href="/geojson-interactif" class="project-card featured">
        <span class="card-number">04 / INTERACTION</span>
        <span class="card-arrow" aria-hidden="true">↗</span>

        <div class="card-visual interactive-visual" aria-hidden="true">
          <div class="interactive-grid"></div>
          <div class="interactive-map">
            <svg viewBox="0 0 240 230" role="presentation">
              <path class="region r1" d="M57 15 L120 26 L111 78 L38 107 L16 67 Z" />
              <path class="region r2" d="M120 26 L176 10 L211 64 L197 120 L111 78 Z" />
              <path class="region r3" d="M16 67 L38 107 L110 198 L60 219 L20 163 Z" />
              <path class="region r4" d="M38 107 L111 78 L197 120 L110 198 Z" />
              <path class="region r5" d="M197 120 L223 153 L178 211 L110 198 Z" />
            </svg>
          </div>
          <div class="filter-preview">
            <span>ANNÉE <b>2021</b></span>
            <span>SEXE <b>FEMME</b></span>
            <span>ÂGE <b>TOTAL</b></span>
          </div>
        </div>

        <div class="card-content">
          <span class="card-category">CLIENT-SIDE / FILTRES</span>
          <h3>Carte interactive</h3>
          <p>
            Comparer les populations par année, sexe et tranche
            d'âge grâce à trois filtres dynamiques.
          </p>
          <span class="technology">Astro · Plot · JavaScript</span>
        </div>
      </a>
    </div>
  </section>

  <section class="summary-section">
    <div class="section-heading">
      <div>
        <p class="section-index">02 / MÉTHODOLOGIE</p>
        <h2>Des données <span>à l'écran.</span></h2>
      </div>
      <p>
        Le TP7 met en pratique plusieurs approches complémentaires
        de la visualisation de données sur le web.
      </p>
    </div>

    <div class="method-grid">
      <div><span>01</span><strong>Accessibilité</strong><p>Décrire et rendre les visualisations utilisables.</p></div>
      <div><span>02</span><strong>Cartographie</strong><p>Positionner des données géographiques avec Leaflet.</p></div>
      <div><span>03</span><strong>Représentation</strong><p>Associer des données statistiques à des formes GeoJSON.</p></div>
      <div><span>04</span><strong>Interaction</strong><p>Mettre à jour une visualisation depuis le navigateur.</p></div>
    </div>
  </section>
</TP4Layout>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
    align-items: center;
    gap: 60px;
    min-height: 600px;
    padding: 35px 0 110px;
  }

  .hero-grid {
    position: absolute;
    inset: -100px -100px 0;
    pointer-events: none;
    opacity: .45;
    background-image:
      linear-gradient(rgba(139,124,255,.035) 1px,transparent 1px),
      linear-gradient(90deg,rgba(139,124,255,.035) 1px,transparent 1px);
    background-size: 55px 55px;
    mask-image: radial-gradient(ellipse at center,#000,transparent 70%);
  }

  .hero-content { position: relative; z-index: 1; animation: rise .7s ease both; }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 26px;
    color: #9b8eff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .pulse {
    width: 7px;
    height: 7px;
    flex: 0 0 7px;
    border-radius: 50%;
    background: #8b7cff;
    animation: pulse 2s infinite;
  }

  h1 {
    max-width: 740px;
    margin: 0 0 28px;
    font-size: clamp(52px,6.5vw,94px);
    line-height: 1.08;
    letter-spacing: -.055em;
    overflow-wrap: normal;
  }

  h1 span { display: block; color: #8b7cff; }

  .hero-description {
    max-width: 570px;
    margin: 0 0 35px;
    color: #a4a7b7;
    font-size: 16px;
    line-height: 1.75;
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: transform .25s,border-color .25s,background .25s;
  }

  .button:hover { transform: translateY(-3px); }
  .button.primary { color: #090b12; background: #8b7cff; }
  .button.primary:hover { background: #a297ff; }
  .button.secondary { border: 1px solid #34364a; color: #c3c5d1; background: #141622; }
  .button.secondary:hover { border-color: #8b7cff; }

  /* HERO VISUEL */

  .data-visual {
    position: relative;
    min-width: 0;
    padding: 24px;
    border: 1px solid #303247;
    border-radius: 22px;
    background: linear-gradient(145deg,#171925,#0d0f17);
    box-shadow: 0 35px 90px rgba(0,0,0,.25);
    overflow: hidden;
    animation: rise .9s .1s ease both;
  }

  .visual-header,.visual-footer { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .visual-header { color: #8f93a7; font-size: 10px; font-weight: 800; letter-spacing: 1.4px; }
  .live { display: flex; align-items: center; gap: 8px; color: #9b8eff; }
  .live i { width: 6px; height: 6px; border-radius: 50%; background: #8b7cff; }

  .visual-scene { position: relative; height: 310px; overflow: hidden; }
  .scene-grid,.map-grid,.geo-grid,.interactive-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(139,124,255,.045) 1px,transparent 1px),
      linear-gradient(90deg,rgba(139,124,255,.045) 1px,transparent 1px);
    background-size: 35px 35px;
  }

  .orbit {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 1px solid rgba(139,124,255,.24);
    border-radius: 50%;
    transform: translate(-50%,-50%);
  }
  .orbit-one { width: 260px; height: 260px; animation: orbit 20s linear infinite; }
  .orbit-two { width: 190px; height: 190px; border-style: dashed; animation: orbit 15s linear infinite reverse; }
  .orbit-three { width: 120px; height: 120px; }
  .orbit-one::after,.orbit-two::after {
    content: "";
    position: absolute;
    top: 12%;
    left: 19%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #8b7cff;
    box-shadow: 0 0 18px #8b7cff;
  }
  .scene-core {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 85px;
    height: 85px;
    border: 1px solid #6156aa;
    border-radius: 50%;
    color: #c3baff;
    background: #171627;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 2px;
    transform: translate(-50%,-50%);
  }
  .scene-node {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #8b7cff;
    box-shadow: 0 0 14px #8b7cff;
    animation: pulse 2.5s infinite;
  }
  .n1 { top: 16%; left: 20%; }
  .n2 { top: 28%; right: 15%; animation-delay: .5s; }
  .n3 { bottom: 17%; left: 26%; animation-delay: 1s; }
  .n4 { bottom: 22%; right: 18%; animation-delay: 1.5s; }

  .visual-footer { border-top: 1px solid #303247; padding-top: 17px; }
  .visual-footer div { display: flex; flex-direction: column; gap: 5px; }
  .visual-footer small { color: #777b91; font-size: 9px; letter-spacing: 1px; }
  .visual-footer strong { color: #d3d0e4; font-size: 13px; }

  /* SECTIONS */

  .explore,.summary-section { padding: 90px 0; border-top: 1px solid #292b39; }
  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 42px;
  }
  .section-index { margin: 0 0 12px; color: #8b7cff; font-size: 11px; font-weight: 800; letter-spacing: 2px; }
  .section-heading h2 { margin: 0; font-size: clamp(35px,4vw,56px); letter-spacing: -.045em; line-height: 1.18; }
  .section-heading h2 span { color: #8b7cff; }
  .section-heading > p { max-width: 430px; margin: 0; color: #969aaa; line-height: 1.7; }

  /* CARTES */

  .card-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20px; }
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 465px;
    padding: 28px;
    overflow: hidden;
    border: 1px solid #292b40;
    border-radius: 22px;
    color: #f7f7fa;
    background: linear-gradient(145deg,#171925,#0e1019);
    text-decoration: none;
    transition: transform .3s,border-color .3s,box-shadow .3s;
  }
  .project-card:hover,.project-card:focus-visible {
    transform: translateY(-7px);
    border-color: #8b7cff;
    box-shadow: 0 25px 55px rgba(0,0,0,.25);
  }
  .project-card.featured { border-color: #51477f; }
  .card-number { color: #85899e; font-size: 10px; font-weight: 800; letter-spacing: 1.4px; }
  .card-arrow {
    position: absolute;
    top: 24px;
    right: 24px;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid #393456;
    border-radius: 50%;
    color: #a79aff;
    font-size: 19px;
    transition: background .25s,color .25s;
  }
  .project-card:hover .card-arrow { color: #090b12; background: #8b7cff; }
  .card-visual { position: relative; height: 215px; margin: 20px 0 24px; overflow: hidden; }
  .card-content { margin-top: auto; }
  .card-category { color: #9b8eff; font-size: 10px; font-weight: 800; letter-spacing: 1.4px; }
  .card-content h3 { margin: 9px 0 12px; font-size: clamp(25px,3vw,34px); letter-spacing: -.035em; }
  .card-content p { max-width: 440px; margin: 0 0 20px; color: #9b9eaf; font-size: 14px; line-height: 1.65; }
  .technology {
    display: inline-block;
    padding: 8px 11px;
    border: 1px solid #393456;
    border-radius: 7px;
    color: #aa9fff;
    background: #1a1928;
    font-family: monospace;
    font-size: 11px;
  }

  /* ACCESSIBILITÉ */

  .a11y-visual { display: flex; align-items: center; justify-content: center; }
  .bar-chart { display: flex; align-items: flex-end; gap: 14px; width: min(72%,340px); height: 165px; }
  .bar-chart span {
    flex: 1;
    height: var(--h);
    border-radius: 5px 5px 0 0;
    background: linear-gradient(0deg,#493d8d,#9b8eff);
    transform-origin: bottom;
    animation: grow 1s var(--d) ease both;
  }
  .chart-baseline { position: absolute; bottom: 24px; left: 12%; right: 12%; height: 1px; background: #414057; }
  .a11y-label {
    position: absolute;
    top: 15px;
    right: 12%;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 11px;
    border: 1px solid #51477f;
    border-radius: 7px;
    color: #bfb6ff;
    background: #1c1b2c;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
  }
  .a11y-check { font-size: 15px; }

  /* LEAFLET */

  .leaflet-visual { border-radius: 10px; background: #131625; }
  .map-lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .map-lines path { fill: none; stroke: #373651; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .map-pin {
    position: absolute;
    display: grid;
    place-items: center;
    width: 17px;
    height: 17px;
    border: 2px solid #b5aaff;
    border-radius: 50%;
    background: #8b7cff;
    box-shadow: 0 0 0 6px rgba(139,124,255,.13);
    animation: pin 2.5s ease-in-out infinite;
  }
  .map-pin i { width: 4px; height: 4px; border-radius: 50%; background: #fff; }
  .pin-one { left: 24%; top: 39%; }
  .pin-two { left: 48%; top: 25%; animation-delay: .5s; }
  .pin-three { left: 68%; top: 62%; animation-delay: 1s; }
  .pin-four { left: 81%; top: 20%; animation-delay: 1.5s; }
  .pin-five { left: 34%; top: 75%; animation-delay: 2s; }

  /* GEOJSON */

  .geo-visual,.interactive-visual { display: grid; place-items: center; }
  .geo-shape,.interactive-map { position: relative; height: 200px; aspect-ratio: 240/230; }
  .geo-shape svg,.interactive-map svg { width: 100%; height: 100%; overflow: visible; }
  .geo-shape svg path:first-child { fill: #322957; stroke: #a99eff; stroke-width: 2; }
  .geo-shape svg path:last-child { fill: none; stroke: #8274c4; stroke-width: 1.5; stroke-linejoin: round; }
  .geo-shape { animation: float 4s ease-in-out infinite; }
  .geo-caption { position: absolute; right: 12%; bottom: 16px; color: #8f84d9; font-size: 10px; font-weight: 800; letter-spacing: 1px; }

  /* INTERACTIF */

  .interactive-map { transform: translateX(-60px); }
  .interactive-map .region { stroke: #b4a8ff; stroke-width: 2; animation: recolor 6s ease-in-out infinite alternate; }
  .r1 { fill: #4c3985; }
  .r2 { fill: #6f55b2; animation-delay: 1s !important; }
  .r3 { fill: #36285d; animation-delay: 2s !important; }
  .r4 { fill: #977deb; animation-delay: 3s !important; }
  .r5 { fill: #5b4695; animation-delay: 4s !important; }
  .filter-preview {
    position: absolute;
    right: 4%;
    top: 28px;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .filter-preview span {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 105px;
    padding: 9px 11px;
    border: 1px solid #393456;
    border-radius: 7px;
    color: #8885a9;
    background: #191928;
    font-size: 9px;
    letter-spacing: 1px;
  }
  .filter-preview b { color: #c6bbff; font-size: 12px; }

  /* MÉTHODOLOGIE */

  .method-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 16px; }
  .method-grid > div { padding: 25px; border: 1px solid #292b40; border-radius: 14px; background: #12141e; }
  .method-grid span { display: block; margin-bottom: 26px; color: #8b7cff; font-size: 11px; font-weight: 800; }
  .method-grid strong { display: block; margin-bottom: 12px; font-size: 18px; }
  .method-grid p { margin: 0; color: #9296a8; font-size: 13px; line-height: 1.6; }

  @keyframes rise { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes orbit { from { transform: translate(-50%,-50%) rotate(0); } to { transform: translate(-50%,-50%) rotate(360deg); } }
  @keyframes pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(139,124,255,.4); } 50% { box-shadow: 0 0 0 8px rgba(139,124,255,0); } }
  @keyframes grow { from { transform: scaleY(.08); } to { transform: scaleY(1); } }
  @keyframes pin { 0%,100% { box-shadow: 0 0 0 4px rgba(139,124,255,.12); } 50% { box-shadow: 0 0 0 12px rgba(139,124,255,0); } }
  @keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-9px); } }
  @keyframes recolor { from { filter: brightness(.8); } to { filter: brightness(1.5); } }

  @media (max-width: 1050px) {
    .hero { grid-template-columns: 1fr; }
    .data-visual { max-width: 700px; width: 100%; }
    .method-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
  }
  @media (max-width: 750px) {
    .card-grid { grid-template-columns: 1fr; }
    .section-heading { align-items: flex-start; flex-direction: column; gap: 18px; }
    .hero { padding-bottom: 75px; }
    .explore,.summary-section { padding: 65px 0; }
  }
  @media (max-width: 480px) {
    h1 { font-size: clamp(42px,12vw,62px); }
    .hero-description { font-size: 15px; }
    .project-card { padding: 20px; }
    .method-grid { grid-template-columns: 1fr; }
    .filter-preview { right: 0; }
    .interactive-map { transform: translateX(-35px) scale(.85); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-content,.data-visual,.orbit,.scene-node,.bar-chart span,.map-pin,.geo-shape,.interactive-map .region {
      animation: none !important;
    }
  }
</style>
