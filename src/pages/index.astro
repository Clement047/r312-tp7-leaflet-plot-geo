---
import TP4Layout from "../layouts/TP4Layout.astro";
---

<TP4Layout title="Plot Lab — Observable Plot">

  <section class="hero">

    <div class="hero-grid"></div>

    <div class="hero-content">

      <div class="eyebrow">
        <span class="pulse"></span>
        OBSERVABLE PLOT · ASTRO
      </div>

      <h1>
        Explorer les données,
        <span>autrement.</span>
      </h1>

      <p class="hero-description">
        Une exploration de plusieurs datasets avec Observable Plot,
        à travers des rendus dynamiques et statiques générés avec Astro.
      </p>

      <div class="hero-actions">

        <a
          href="/rendu-dynamique"
          class="button primary"
        >
          Explorer
          <span>↗</span>
        </a>

        <a
          href="/toutes-les-especes"
          class="button secondary"
        >
          Voir les graphiques
        </a>

      </div>

    </div>


    <!-- VISUEL DATA -->

    <div class="data-visual">

      <div class="visual-header">

        <span>
          LIVE DATA
        </span>

        <div class="live">
          <span></span>
          ACTIVE
        </div>

      </div>


      <div class="plot-area">

        <div class="grid"></div>

        <div class="axis axis-x"></div>
        <div class="axis axis-y"></div>

        <svg
          class="trend"
          viewBox="0 0 500 250"
          preserveAspectRatio="none"
        >
          <path
            class="trend-path"
            d="
              M 30 200
              C 80 185, 90 160, 135 168
              S 190 130, 230 142
              S 290 85, 330 110
              S 390 60, 465 45
            "
          />
        </svg>

        <span class="point p1"></span>
        <span class="point p2"></span>
        <span class="point p3"></span>
        <span class="point p4"></span>
        <span class="point p5"></span>
        <span class="point p6"></span>

      </div>


      <div class="visual-footer">

        <span>
          DATASETS
          <strong>02</strong>
        </span>

        <span>
          MODES
          <strong>02</strong>
        </span>

        <span>
          ENGINE
          <strong>PLOT</strong>
        </span>

      </div>

    </div>

  </section>


  <!-- MODES -->

  <section class="explore">

    <div class="section-heading">

      <div>

        <p class="section-index">
          01 / EXPLORATION
        </p>

        <h2>
          Deux modes de rendu.
        </h2>

      </div>

      <p>
        Compare la génération dynamique avec
        <code>Astro.params</code> et la génération statique
        avec <code>getStaticPaths()</code>.
      </p>

    </div>


    <div class="mode-grid">

      <!-- DYNAMIC -->

      <a
        href="/rendu-dynamique"
        class="mode-card dynamic"
      >

        <div class="card-number">
          01
        </div>

        <div class="mode-visual">

          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>

          <div class="core">
            <span></span>
          </div>

        </div>


        <div class="mode-content">

          <div class="mode-label">
            <span class="live-dot"></span>
            SERVER
          </div>

          <h3>
            Dynamique
          </h3>

          <p>
            Les pages sont générées à la demande
            à partir des paramètres de l'URL.
          </p>

          <div class="technology">
            Astro.params
          </div>

        </div>


        <span class="arrow">
          ↗
        </span>

      </a>


      <!-- STATIC -->

      <a
        href="/rendu-statique"
        class="mode-card static"
      >

        <div class="card-number">
          02
        </div>


        <div class="mode-visual static-visual">

          <span class="static-line l1"></span>
          <span class="static-line l2"></span>
          <span class="static-line l3"></span>
          <span class="static-line l4"></span>
          <span class="static-line l5"></span>

        </div>


        <div class="mode-content">

          <div class="mode-label">
            BUILD
          </div>

          <h3>
            Statique
          </h3>

          <p>
            Les routes sont générées à l'avance
            pendant le build du projet.
          </p>

          <div class="technology">
            getStaticPaths()
          </div>

        </div>


        <span class="arrow">
          ↗
        </span>

      </a>

    </div>

  </section>


  <!-- DATASETS -->

  <section class="datasets-section">

    <div class="section-heading">

      <div>

        <p class="section-index">
          02 / DATASETS
        </p>

        <h2>
          Les données explorées.
        </h2>

      </div>

    </div>


    <div class="dataset-row">

      <div class="dataset-info">

        <span class="dataset-number">
          01
        </span>

        <div>

          <h3>
            Penguins
          </h3>

          <p>
            Adelie · Chinstrap · Gentoo
          </p>

        </div>

      </div>


      <div class="dataset-meta">

        <span>
          3 espèces
        </span>

        <a href="/toutes-les-especes">
          Explorer
          <strong>↗</strong>
        </a>

      </div>

    </div>


    <div class="dataset-row">

      <div class="dataset-info">

        <span class="dataset-number">
          02
        </span>

        <div>

          <h3>
            Weather
          </h3>

          <p>
            Températures · Conditions météo
          </p>

        </div>

      </div>


      <div class="dataset-meta">

        <span>
          Weather data
        </span>

        <a href="/tous-les-weather">
          Explorer
          <strong>↗</strong>
        </a>

      </div>

    </div>

  </section>

</TP4Layout>


<style>

  /* ================================ */
  /* HERO                             */
  /* ================================ */

  .hero {
    position: relative;

    min-height: 650px;

    display: grid;

    grid-template-columns:
      1.05fr
      0.95fr;

    align-items: center;

    gap: 70px;

    padding:
      40px
      0
      110px;

    overflow: hidden;
  }


  .hero-grid {
    position: absolute;

    inset:
      -100px
      -300px
      0;

    pointer-events: none;

    opacity: 0.4;

    background:
      linear-gradient(
        rgba(139, 124, 255, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(139, 124, 255, 0.035) 1px,
        transparent 1px
      );

    background-size:
      55px 55px;

    mask-image:
      radial-gradient(
        ellipse at center,
        black,
        transparent 70%
      );
  }


  .hero-content {
    position: relative;

    z-index: 2;

    animation:
      heroIn
      0.8s
      cubic-bezier(.2,.8,.2,1)
      both;
  }


  .eyebrow {
    display: flex;

    align-items: center;

    gap: 10px;

    margin-bottom: 25px;

    color: #8b7cff;

    font-size: 11px;
    font-weight: 800;

    letter-spacing: 2.2px;
  }


  .pulse {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #8b7cff;

    animation:
      pulse
      2s
      infinite;
  }


  h1 {
    max-width: 700px;

    margin-bottom: 28px;

    font-size:
      clamp(
        58px,
        7vw,
        96px
      );

    line-height: 0.88;

    letter-spacing: -6px;
  }


  h1 span {
    display: block;

    color: #8b7cff;
  }


  .hero-description {
    max-width: 610px;

    margin:
      0
      0
      35px;

    color: #8b90a0;

    font-size: 17px;

    line-height: 1.7;
  }


  /* BUTTONS */

  .hero-actions {
    display: flex;

    flex-wrap: wrap;

    gap: 12px;
  }


  .button {
    min-height: 48px;

    padding:
      0
      20px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 18px;

    border-radius: 10px;

    font-size: 13px;
    font-weight: 700;

    text-decoration: none;

    transition:
      transform 0.25s,
      border-color 0.25s,
      background 0.25s;
  }


  .button:hover {
    transform:
      translateY(-3px);
  }


  .button.primary {
    color: #090b12;

    background: #8b7cff;
  }


  .button.primary:hover {
    background: #a297ff;
  }


  .button.secondary {
    border:
      1px solid
      rgba(255,255,255,0.1);

    color: #b5b8c3;

    background:
      rgba(255,255,255,0.025);
  }


  .button.secondary:hover {
    border-color:
      rgba(139,124,255,0.4);

    color: white;
  }


  /* ================================ */
  /* HERO DATA VISUAL                 */
  /* ================================ */

  .data-visual {
    position: relative;

    z-index: 2;

    min-height: 430px;

    padding: 22px;

    border:
      1px solid
      rgba(255,255,255,0.09);

    border-radius: 22px;

    background:
      linear-gradient(
        145deg,
        rgba(21,23,34,0.92),
        rgba(11,13,21,0.95)
      );

    box-shadow:
      0 40px 100px
      rgba(0,0,0,0.3);

    animation:
      visualIn
      0.9s
      0.15s
      cubic-bezier(.2,.8,.2,1)
      both;
  }


  .data-visual::before {
    content: "";

    position: absolute;

    width: 300px;
    height: 300px;

    top: -150px;
    right: -120px;

    border-radius: 50%;

    background:
      rgba(139,124,255,0.15);

    filter:
      blur(70px);

    pointer-events: none;
  }


  .visual-header {
    display: flex;

    justify-content: space-between;

    align-items: center;

    color: #656a79;

    font-size: 9px;
    font-weight: 800;

    letter-spacing: 1.5px;
  }


  .live {
    display: flex;

    align-items: center;

    gap: 7px;

    color: #8b7cff;
  }


  .live span {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #8b7cff;

    box-shadow:
      0 0 10px
      #8b7cff;
  }


  .plot-area {
    position: relative;

    height: 300px;

    margin-top: 20px;

    overflow: hidden;
  }


  .grid {
    position: absolute;

    inset: 0;

    background:
      linear-gradient(
        rgba(139,124,255,0.045) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(139,124,255,0.045) 1px,
        transparent 1px
      );

    background-size:
      40px 40px;
  }


  .axis {
    position: absolute;

    background:
      rgba(255,255,255,0.09);
  }


  .axis-x {
    left: 20px;
    right: 10px;

    bottom: 20px;

    height: 1px;
  }


  .axis-y {
    left: 20px;

    top: 10px;
    bottom: 20px;

    width: 1px;
  }


  .trend {
    position: absolute;

    inset:
      10px
      10px
      20px
      20px;

    width:
      calc(100% - 30px);

    height:
      calc(100% - 30px);

    overflow: visible;
  }


  .trend-path {
    fill: none;

    stroke: #8b7cff;

    stroke-width: 2;

    vector-effect:
      non-scaling-stroke;

    stroke-dasharray: 800;

    stroke-dashoffset: 800;

    filter:
      drop-shadow(
        0 0 7px
        rgba(139,124,255,0.45)
      );

    animation:
      drawLine
      2s
      0.7s
      ease
      forwards;
  }


  .point {
    position: absolute;

    width: 8px;
    height: 8px;

    border:
      2px solid
      #8b7cff;

    border-radius: 50%;

    background: #11131d;

    box-shadow:
      0 0 12px
      rgba(139,124,255,0.7);

    opacity: 0;

    animation:
      pointIn
      0.4s
      ease
      forwards;
  }


  .p1 {
    left: 15%;
    bottom: 28%;

    animation-delay: 1s;
  }


  .p2 {
    left: 30%;
    bottom: 40%;

    animation-delay: 1.15s;
  }


  .p3 {
    left: 45%;
    bottom: 46%;

    animation-delay: 1.3s;
  }


  .p4 {
    left: 60%;
    bottom: 59%;

    animation-delay: 1.45s;
  }


  .p5 {
    left: 74%;
    bottom: 66%;

    animation-delay: 1.6s;
  }


  .p6 {
    left: 88%;
    bottom: 79%;

    animation-delay: 1.75s;
  }


  .visual-footer {
    display: grid;

    grid-template-columns:
      repeat(3,1fr);

    gap: 8px;

    padding-top: 15px;

    border-top:
      1px solid
      rgba(255,255,255,0.06);
  }


  .visual-footer span {
    display: flex;

    flex-direction: column;

    gap: 4px;

    color: #555a69;

    font-size: 8px;
    font-weight: 800;

    letter-spacing: 1px;
  }


  .visual-footer strong {
    color: #a4a8b4;

    font-size: 12px;
  }


  /* ================================ */
  /* SECTIONS                         */
  /* ================================ */

  .explore,
  .datasets-section {
    padding:
      100px
      0;
  }


  .explore {
    border-top:
      1px solid
      rgba(255,255,255,0.07);
  }


  .section-heading {
    margin-bottom: 45px;

    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 50px;
  }


  .section-index {
    margin:
      0
      0
      12px;

    color: #8b7cff;

    font-size: 10px;
    font-weight: 800;

    letter-spacing: 2px;
  }


  .section-heading h2 {
    margin: 0;

    font-size:
      clamp(
        36px,
        5vw,
        55px
      );

    letter-spacing: -2.5px;
  }


  .section-heading > p {
    max-width: 430px;

    margin: 0;

    color: #777c8c;

    line-height: 1.6;
  }


  code {
    color: #aaa0ff;
  }


  /* ================================ */
  /* MODE CARDS                       */
  /* ================================ */

  .mode-grid {
    display: grid;

    grid-template-columns:
      repeat(2,1fr);

    gap: 18px;
  }


  .mode-card {
    position: relative;

    min-height: 470px;

    padding: 27px;

    display: flex;

    flex-direction: column;

    overflow: hidden;

    border:
      1px solid
      rgba(255,255,255,0.08);

    border-radius: 22px;

    color: white;

    background:
      linear-gradient(
        145deg,
        #151722,
        #0d0f17
      );

    text-decoration: none;

    transition:
      0.35s ease;
  }


  .mode-card:hover {
    transform:
      translateY(-8px);

    border-color:
      rgba(139,124,255,0.5);

    box-shadow:
      0 30px 70px
      rgba(0,0,0,0.25);
  }


  .card-number {
    color: #5f6473;

    font-size: 10px;
    font-weight: 800;

    letter-spacing: 1px;
  }


  .mode-visual {
    position: relative;

    height: 200px;

    margin:
      20px
      0;
  }


  /* DYNAMIC ORBITS */

  .orbit {
    position: absolute;

    top: 50%;
    left: 50%;

    border:
      1px solid
      rgba(139,124,255,0.18);

    border-radius: 50%;

    transform:
      translate(-50%,-50%);
  }


  .orbit-one {
    width: 180px;
    height: 180px;

    animation:
      rotate
      12s
      linear
      infinite;
  }


  .orbit-one::after {
    content: "";

    position: absolute;

    top: 12px;
    left: 40px;

    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #8b7cff;

    box-shadow:
      0 0 15px
      #8b7cff;
  }


  .orbit-two {
    width: 125px;
    height: 125px;

    border-style: dashed;

    animation:
      rotateReverse
      9s
      linear
      infinite;
  }


  .core {
    position: absolute;

    top: 50%;
    left: 50%;

    width: 60px;
    height: 60px;

    display: grid;

    place-items: center;

    border:
      1px solid
      rgba(139,124,255,0.35);

    border-radius: 50%;

    transform:
      translate(-50%,-50%);
  }


  .core span {
    width: 13px;
    height: 13px;

    border-radius: 50%;

    background: #8b7cff;

    box-shadow:
      0 0 25px
      rgba(139,124,255,0.8);
  }


  /* STATIC VISUAL */

  .static-visual {
    display: flex;

    flex-direction: column;

    justify-content: center;

    gap: 12px;

    padding:
      30px
      40px;
  }


  .static-line {
    height: 9px;

    border-radius: 20px;

    background:
      linear-gradient(
        90deg,
        rgba(139,124,255,0.8),
        rgba(139,124,255,0.08)
      );

    transform-origin: left;

    transition:
      transform 0.4s;
  }


  .l1 { width: 80%; }
  .l2 { width: 55%; }
  .l3 { width: 92%; }
  .l4 { width: 67%; }
  .l5 { width: 42%; }


  .mode-card:hover .static-line {
    transform:
      scaleX(1.06);
  }


  .mode-content {
    margin-top: auto;
  }


  .mode-label {
    margin-bottom: 8px;

    display: flex;

    align-items: center;

    gap: 7px;

    color: #8b7cff;

    font-size: 9px;
    font-weight: 800;

    letter-spacing: 1.5px;
  }


  .live-dot {
    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: #8b7cff;
  }


  .mode-content h3 {
    margin:
      0
      0
      10px;

    font-size: 32px;
  }


  .mode-content p {
    max-width: 400px;

    margin:
      0
      0
      20px;

    color: #777c8c;

    font-size: 14px;

    line-height: 1.6;
  }


  .technology {
    display: inline-flex;

    padding: 7px 10px;

    border:
      1px solid
      rgba(139,124,255,0.18);

    border-radius: 7px;

    color: #9e94ff;

    background:
      rgba(139,124,255,0.05);

    font-family: monospace;

    font-size: 11px;
  }


  .arrow {
    position: absolute;

    top: 25px;
    right: 25px;

    width: 42px;
    height: 42px;

    display: grid;

    place-items: center;

    border:
      1px solid
      rgba(139,124,255,0.25);

    border-radius: 50%;

    color: #8b7cff;

    transition: 0.3s;
  }


  .mode-card:hover .arrow {
    color: #090b12;

    background: #8b7cff;

    transform:
      rotate(45deg);
  }


  /* ================================ */
  /* DATASET ROWS                     */
  /* ================================ */

  .datasets-section {
    border-top:
      1px solid
      rgba(255,255,255,0.07);
  }


  .dataset-row {
    min-height: 125px;

    padding:
      25px
      10px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 30px;

    border-bottom:
      1px solid
      rgba(255,255,255,0.07);

    transition:
      padding 0.3s,
      background 0.3s;
  }


  .dataset-row:hover {
    padding:
      25px
      25px;

    background:
      rgba(139,124,255,0.025);
  }


  .dataset-info {
    display: flex;

    align-items: center;

    gap: 30px;
  }


  .dataset-number {
    color: #555a69;

    font-size: 11px;
    font-weight: 800;
  }


  .dataset-info h3 {
    margin:
      0
      0
      7px;

    font-size: 27px;
  }


  .dataset-info p {
    margin: 0;

    color: #6f7483;

    font-size: 13px;
  }


  .dataset-meta {
    display: flex;

    align-items: center;

    gap: 35px;

    color: #606574;

    font-size: 11px;
  }


  .dataset-meta a {
    display: flex;

    align-items: center;

    gap: 10px;

    color: #a29aff;

    font-size: 12px;
    font-weight: 700;

    text-decoration: none;
  }


  .dataset-meta a strong {
    transition:
      transform 0.25s;
  }


  .dataset-meta a:hover strong {
    transform:
      translate(
        3px,
        -3px
      );
  }


  /* ================================ */
  /* ANIMATIONS                       */
  /* ================================ */

  @keyframes heroIn {

    from {
      opacity: 0;

      transform:
        translateY(25px);
    }

    to {
      opacity: 1;

      transform:
        translateY(0);
    }

  }


  @keyframes visualIn {

    from {
      opacity: 0;

      transform:
        translateY(30px)
        scale(0.97);
    }

    to {
      opacity: 1;

      transform:
        translateY(0)
        scale(1);
    }

  }


  @keyframes drawLine {

    to {
      stroke-dashoffset: 0;
    }

  }


  @keyframes pointIn {

    from {
      opacity: 0;

      transform:
        scale(0);
    }

    to {
      opacity: 1;

      transform:
        scale(1);
    }

  }


  @keyframes pulse {

    0% {
      box-shadow:
        0 0 0 0
        rgba(139,124,255,0.5);
    }

    70% {
      box-shadow:
        0 0 0 8px
        rgba(139,124,255,0);
    }

    100% {
      box-shadow:
        0 0 0 0
        rgba(139,124,255,0);
    }

  }


  @keyframes rotate {

    from {
      transform:
        translate(-50%,-50%)
        rotate(0deg);
    }

    to {
      transform:
        translate(-50%,-50%)
        rotate(360deg);
    }

  }


  @keyframes rotateReverse {

    from {
      transform:
        translate(-50%,-50%)
        rotate(360deg);
    }

    to {
      transform:
        translate(-50%,-50%)
        rotate(0deg);
    }

  }


  /* ================================ */
  /* RESPONSIVE                       */
  /* ================================ */

  @media (max-width: 900px) {

    .hero {
      grid-template-columns: 1fr;

      gap: 50px;
    }


    h1 {
      letter-spacing: -4px;
    }


    .data-visual {
      min-height: 390px;
    }


    .mode-grid {
