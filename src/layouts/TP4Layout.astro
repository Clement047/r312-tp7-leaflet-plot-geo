
---
interface Props {
  title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;

const navigation = [
  { label: "Accueil", href: "/" },
  { label: "Accessibilité", href: "/simple-penguin" },
  { label: "Leaflet", href: "/leaflet" },
  { label: "GeoJSON", href: "/geojson" },
  { label: "Interactif", href: "/geojson-interactif" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="TP7 : cartographie et visualisation de données avec Astro, Leaflet et Observable Plot."
    />
    <title>{title} | PLOT / LAB</title>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo" aria-label="PLOT LAB — Accueil">
          <span>PLOT</span>
          <span class="slash">/</span>
          <strong>LAB</strong>
        </a>

        <nav aria-label="Navigation principale">
          {navigation.map((item) => (
            <a
              href={item.href}
              class:active={pathname === item.href}
              aria-current={pathname === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-logo">
          <span>PLOT</span>
          <span class="slash">/</span>
          <strong>LAB</strong>
        </div>

        <p>TP7 — ASTRO × LEAFLET × OBSERVABLE PLOT</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    margin: 0;
    padding: 0;
    scroll-behavior: smooth;
    background: #090b12;
  }

  body {
    min-height: 100vh;
    margin: 0;
    padding: 0;
    color: #f7f7fa;
    background:
      radial-gradient(
        circle at 50% -20%,
        rgba(139, 124, 255, 0.07),
        transparent 35%
      ),
      #090b12;
    font-family: Inter, Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  a {
    color: inherit;
  }

  ::selection {
    color: #090b12;
    background: #8b7cff;
  }

  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: #090b12;
  }

  ::-webkit-scrollbar-thumb {
    border-radius: 20px;
    background: #292c39;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #8b7cff;
  }

  /* HEADER */

  .site-header {
    position: sticky;
    z-index: 100;
    top: 0;
    width: 100%;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(9, 11, 18, 0.84);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .header-inner {
    width: min(1400px, calc(100% - 80px));
    min-height: 90px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
  }

  /* LOGO */

  .logo {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
    color: #f7f7fa;
    font-size: 23px;
    font-weight: 900;
    letter-spacing: -1px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .logo:hover {
    opacity: 0.8;
  }

  .logo .slash,
  .footer-logo .slash {
    color: #4f5361;
  }

  .logo strong,
  .footer-logo strong {
    color: #8b7cff;
  }

  /* NAVIGATION */

  nav {
    display: flex;
    align-items: center;
    align-self: stretch;
    gap: 36px;
  }

  nav a {
    position: relative;
    display: flex;
    align-items: center;
    color: #9094a3;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s ease;
  }

  nav a:hover,
  nav a.active {
    color: #ffffff;
  }

  nav a::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 27px;
    left: 0;
    height: 2px;
    border-radius: 20px;
    background: #8b7cff;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }

  nav a:hover::after,
  nav a.active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  nav a:focus-visible,
  .logo:focus-visible {
    outline: 2px solid #8b7cff;
    outline-offset: 5px;
  }

  /* CONTENU */

  #contenu {
    width: min(1400px, calc(100% - 80px));
    min-height: calc(100vh - 210px);
    margin: 0 auto;
    padding: 70px 0 100px;
  }

  h1,
  h2,
  h3 {
    color: #f7f7fa;
  }

  /* GRAPHIQUES */

  .plot-container {
    width: 100%;
    overflow-x: auto;
  }

  .plot-container svg {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  /* FOOTER */

  .site-footer {
    width: 100%;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .footer-inner {
    width: min(1400px, calc(100% - 80px));
    min-height: 120px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 5px;
    color: #b9bcc7;
    font-size: 15px;
    font-weight: 900;
  }

  .footer-inner p {
    margin: 0;
    color: #777b8d;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* RESPONSIVE */

  @media (max-width: 900px) {
    .header-inner {
      width: calc(100% - 40px);
      min-height: 80px;
      padding: 20px 0;
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }

    nav {
      width: 100%;
      align-self: auto;
      gap: 28px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    nav::-webkit-scrollbar {
      display: none;
    }

    nav a {
      min-height: 40px;
    }

    nav a::after {
      bottom: 0;
    }

    #contenu {
      width: calc(100% - 40px);
      padding-top: 50px;
    }

    .footer-inner {
      width: calc(100% - 40px);
    }
  }

  @media (max-width: 600px) {
    .logo {
      font-size: 20px;
    }

    nav {
      gap: 22px;
    }

    nav a {
      font-size: 12px;
    }

    #contenu {
      width: calc(100% - 24px);
      padding: 40px 0 70px;
    }

    .footer-inner {
      min-height: 100px;
      align-items: flex-start;
      justify-content: center;
      flex-direction: column;
      gap: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
